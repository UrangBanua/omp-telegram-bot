# ==========================================
# 1. KREDENSIAL BOT TELEGRAM (Wajib)
# ==========================================
# Dapatkan token bot Anda dari @BotFather di Telegram
TELOXIDE_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ==========================================
# 2. OTORISASI & KEAMANAN PENGGUNA (Wajib)
# ==========================================
# Daftar ID Telegram yang diizinkan (pisahkan dengan koma jika lebih dari satu)
# Dapatkan ID akun Anda via bot @userinfobot di Telegram
ALLOWED_USER_IDS=123456789,987654321

# ==========================================
# 3. DIRECTORY WORKSPACE TARGET (Wajib)
# ==========================================
# Folder proyek lokal yang dikelola dan dikerjakan oleh OMP saat bot menerima instruksi
PROJECT_WORKSPACE=D:/PROJECTS/AfniAfdillah/RepositoryGitHub/omp-guides

# ==========================================
# 4. PATH EXECUTABLE OMP CLI (Opsional)
# ==========================================
# Path eksekusi binary omp ("omp" jika sudah ada di PATH sistem)
OMP_BIN_PATH=omp

# ==========================================
# 5. LOG LEVEL APLIKASI (Opsional)
# ==========================================
# Opsi: error, warn, info, debug, trace
RUST_LOG=info
